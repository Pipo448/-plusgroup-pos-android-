<?xml version="1.0" encoding="utf-8"?>
<!--
  REDESIGN — estrikti ID yo rete EGZAKTEMAN menm jan ak orijinal la, kidonk
  DashboardActivity.kt pa bezwen okenn chanjman. Sèl bagay ki chanje se
  estil vizyèl: bouton won anlè, kat balans ak kwen awondi + lonbraj,
  bouton "pilil" anba, ak background ki gen vag (@drawable/bg_wave_blue,
  ki deja egziste nan pwojè a — itilize tou nan activity_my_fiches.xml).

  LOGO: mwen mete yon ImageView ki pwente sou @mipmap/ic_launcher kòm
  plasholder. Si w vle chak tenant afiche PWÒP logo yo (pa yon logo
  jenerik), n ap bezwen chaje l dinamikman ak Glide/Coil apati yon URL
  backend (egzanp company_settings.logo_url) — di m si w vle sa, m ajoute
  lojik la nan DashboardActivity.kt.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_wave_blue">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Ba wo a: enprimant / mesaj / meni — kounye a won -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <ImageButton
                    android:id="@+id/btnPrinter"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentStart="true"
                    android:background="@drawable/bg_circle_button"
                    android:backgroundTint="#22C55E"
                    android:padding="10dp"
                    android:elevation="3dp"
                    android:contentDescription="Enprimant"
                    android:src="@android:drawable/ic_menu_gallery"
                    android:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/btnMail"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_toEndOf="@id/btnPrinter"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_circle_button"
                    android:backgroundTint="#3B82F6"
                    android:padding="10dp"
                    android:elevation="3dp"
                    android:contentDescription="Notifikasyon"
                    android:src="@android:drawable/ic_dialog_email"
                    android:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_circle_button"
                    android:backgroundTint="#F59E0B"
                    android:padding="10dp"
                    android:elevation="3dp"
                    android:contentDescription="Meni"
                    android:src="@android:drawable/ic_menu_more"
                    android:tint="@android:color/white" />
            </RelativeLayout>

            <!-- Logo konpayi a — RETIRE tanporèman paske @mipmap/ic_launcher
                 pa t egziste (erè "resource linking failed"). Si w gen yon
                 fichye logo (.png/.webp), mete l nan res/drawable/ epi
                 ranplase commentaire sa a ak:
                 <ImageView
                     android:layout_width="80dp"
                     android:layout_height="80dp"
                     android:layout_gravity="center"
                     android:layout_marginTop="8dp"
                     android:src="@drawable/NON_FICHYE_LOGO_OU"
                     android:contentDescription="Logo konpayi a" /> -->

            <!-- Salut + rafrechi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingTop="8dp">

                <TextView
                    android:id="@+id/tvSalut"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Salut"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B" />

                <ImageButton
                    android:id="@+id/btnRefresh"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Rafrechi"
                    android:src="@android:drawable/ic_popup_sync" />
            </LinearLayout>

            <!-- Kat balans — kwen awondi + lonbraj -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:padding="24dp"
                android:elevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvBalance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.00"
                            android:textSize="18sp"
                            android:textColor="#888888" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Balance"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvCreditVente"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Illimité"
                            android:textSize="18sp"
                            android:textColor="#888888" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Crédit de vente"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="16dp">

                    <TextView
                        android:id="@+id/tvLimiteGain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Illimité"
                        android:textSize="18sp"
                        android:textColor="#888888" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Limite gain"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bouton prensipal yo — kounye a "pilil" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <Button
                    android:id="@+id/btnNouvelFich"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="12dp"
                    android:text="NOUVÈL FICH"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_button"
                    android:backgroundTint="#22C55E"
                    android:elevation="3dp" />

                <Button
                    android:id="@+id/btnChacheFich"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="12dp"
                    android:text="CHACHE FICH"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_button"
                    android:backgroundTint="#3B82F6"
                    android:elevation="3dp" />

                <Button
                    android:id="@+id/btnFichMwenYo"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="12dp"
                    android:text="FICH MWEN YO"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_button"
                    android:backgroundTint="#F59E0B"
                    android:elevation="3dp" />

                <Button
                    android:id="@+id/btnRapo"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="16dp"
                    android:text="RAPÒ"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill_button"
                    android:backgroundTint="#DC2626"
                    android:elevation="3dp" />
            </LinearLayout>

            <!-- Footer: non konpayi devlopè a -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="20dp"
                android:text="Plus Group Lottery"
                android:textSize="12sp"
                android:textColor="#64748B" />

        </LinearLayout>
    </ScrollView>

    <!-- Ba anba a: Bolèt / Paramèt -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="#3B82F6">

        <LinearLayout
            android:id="@+id/tabBolet"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bolèt"
                android:textColor="@android:color/white"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabParamet"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Paramèt"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>