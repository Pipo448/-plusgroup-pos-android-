<?xml version="1.0" encoding="utf-8"?>
<!--
  REKONSTRIKSYON dezyèm vèsyon — sipòte tout 4 rapò yo (PARTIEL, F.TIRAGE,
  F.GAGNANT, TRASACT) ak F.ELIMINER, ak yon filtè PATAJE (De/A + Tiraj)
  epi yon zòn rezilta ki chanje selon mòd aktif la.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Retounen"
            android:src="@android:drawable/ic_menu_revert" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Rapport"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnPrintReport"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Enprime rapò"
            android:src="@android:drawable/ic_menu_share" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- ==================== BOUTON KATEGORI RAPÒ ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnPartiel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#22C55E"
                    android:textColor="@android:color/white"
                    android:text="PARTIEL" />

                <Button
                    android:id="@+id/btnFTirage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#F59E0B"
                    android:textColor="@android:color/white"
                    android:text="F.TIRAGE" />

                <Button
                    android:id="@+id/btnFGagnant"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="#3B82F6"
                    android:textColor="@android:color/white"
                    android:text="F.GAGNANT" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btnTrasact"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#3B82F6"
                    android:textColor="@android:color/white"
                    android:text="TRASACT.." />

                <Button
                    android:id="@+id/btnFEliminer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="#F59E0B"
                    android:textColor="@android:color/white"
                    android:text="F.ELIMINER" />
            </LinearLayout>

            <!-- ==================== FILTÈ PATAJE: DE / A / TIRAJ ==================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="De"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDateFrom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#808080"
                        android:textColor="@android:color/white"
                        android:padding="12dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="A"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDateTo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#808080"
                        android:textColor="@android:color/white"
                        android:padding="12dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvTirageLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tirage"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <Spinner
                android:id="@+id/spinnerTirage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" />

            <ImageButton
                android:id="@+id/btnSearch"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:backgroundTint="#3B82F6"
                android:contentDescription="Chèche"
                android:src="@android:drawable/ic_menu_search" />

            <!-- ==================== REZILTA — PARTIEL / F.TIRAGE (rezime) ==================== -->
            <LinearLayout
                android:id="@+id/llSummaryResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:id="@+id/tvSummaryTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Rapport partiel"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvBalanceValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text=""
                    android:textSize="26sp"
                    android:textColor="#8B0000"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvBalanceLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Balance"
                    android:textColor="#606060"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/llSummaryRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ==================== REZILTA — LIS (F.GAGNANT / TRASACT / F.ELIMINER) ==================== -->
            <LinearLayout
                android:id="@+id/llListResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvListTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text=""
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvListSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:textColor="#8B0000"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/llListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#3B82F6">

        <LinearLayout
            android:id="@+id/tabBolet"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center" />

        <LinearLayout
            android:id="@+id/tabParamet"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center" />
    </LinearLayout>
</LinearLayout>
